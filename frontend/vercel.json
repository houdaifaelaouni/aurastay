{
  "rewrites": [
    {
      "source": "/((?!static/|pass/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/pass",
      "destination": "/pass/",
      "permanent": false
    },
    {
      "source": "/pass/checkin",
      "destination": "/pass/checkin/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/pass/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
